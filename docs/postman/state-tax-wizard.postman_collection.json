    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}",
                  "if (json.stores && json.stores.length > 0) {",
                  "    pm.collectionVariables.set('store_id', json.stores[0].id);",
                  "}",
                  "pm.test('Token captured', function () {",
                  "    pm.expect(pm.collectionVariables.get('token')).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.user@example.com\",\n  \"password\": \"demo123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": [
            {
              "name": "LoginResponse",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"eyJhbGciOi...\",\n  \"user\": {\n    \"id\": \"e2d8dbf6-3a68-4a33-8f4a-7fd6b2c5e6a4\",\n    \"email\": \"demo.user@example.com\",\n    \"created_at\": \"2024-01-10T15:04:05.123456\"\n  },\n  \"stores\": [\n    {\n      \"id\": \"{{store_id}}\",\n      \"name\": \"store_demo_1\"\n    }\n  ]\n}"
            }
          ]
        }
      ]
